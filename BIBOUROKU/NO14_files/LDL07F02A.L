{\{ ===================================================================== \}}
{\{    \logicso{07F02A}{RS232C 受信}                                      \}}
{\{ ===================================================================== \}}
logicname LDL07F02A

library LDL07E16A

entity main
{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02B}{入力}                                             \}}
{\{ --------------------------------------------------------------------- \}}
input  RESET;      {\{ チップ初期化 \}}
input  RXD;        {\{ 受信端子 \}}
input  SC;         {\{ 受信CLK \}}

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02C}{出力}                                             \}}
{\{ --------------------------------------------------------------------- \}}
output DATA[8];    {\{ 受信データ \}}
output PARITY;     {\{ 受信パリティ \}}

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02E}{内部信号}                                         \}}
{\{ --------------------------------------------------------------------- \}}
bitr   sclk[2];                  {\{ 受信CLK 起点取り出し \}}
bitn   sbp;                      {\{ 受信CLK 起点 \}}
bitr   scclk[4];
bitr   sbcount[4];
bitr   rcomon;
bitn   scbp;
bitn   sbv;
bitn   rcomoff;
bitr   rshift[9];
bitr   rdata[8];
bitr   bitcount[4];
bitr   rparity;
bitr   paritycount[4];
bitr   eparity;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02F}{検査代入}                                         \}}
{\{ --------------------------------------------------------------------- \}}
output T0P;      T0P=rcomon;
output T1P;      T1P=rcomoff;
output T2P[9];   T2P=rshift;
output T3P[4];   T3P=bitcount;
output T4P[4];   T4P=paritycount;
output T5P;      T5P=scbp;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02G}{出力代入}                                         \}}
{\{ --------------------------------------------------------------------- \}}
   DATA=rdata;
   PARITY=eparity;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02H}{受信CLK 起点取り出し}                             \}}
{\{    9600BPS  2.4576MHz/16=153.6KHz                                     \}}
{\{ --------------------------------------------------------------------- \}}
   if (RESET)
      sclk=0;                          {\{ c \}}
   else
      switch(sclk)
         case 0: if (SC) sclk=1; endif {\{ a \}}
         case 1: sclk=2;               {\{ b \}}
         case 2:
            if (SC)
               sclk=sclk;
            else
               sclk=0;                 {\{ c \}}
            endif
      endswitch
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F04A}{受信CLK 起点}                                     \}}
{\{ --------------------------------------------------------------------- \}}
   sbp=sclk.0;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02J}{通信1ビット期間}                                  \}}
{\{    153.6KHz/16=9600BPS                                                \}}
{\{ --------------------------------------------------------------------- \}}
   if (RESET|!rcomon)
      scclk=0;                    {\{ c \}}
   else
      if (sbp)
         scclk=scclk+1;           {\{ a \}}
      else
         scclk=scclk;             {\{ b \}}
      endif
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F04B}{通信1ビット起点}                                  \}}
{\{ --------------------------------------------------------------------- \}}
   scbp=(scclk==15)&sbp;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02K}{受信開始検出}                                     \}}
{\{ --------------------------------------------------------------------- \}}
   if (RESET)
      sbcount=0;                              {\{ c \}}
   else
      if (rcomon)
         sbcount=sbcount;                     {\{ b \}}
      else
         if (RXD)
            sbcount=0;                        {\{ c \}}
         else
            if (sbv)
               sbcount=sbcount;               {\{ b \}}
            else
               if (sbp)
                  sbcount=sbcount+1;          {\{ a \}}
               else
                  sbcount=sbcount;            {\{ b \}}
               endif
            endif
         endif
      endif
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02L}{受信開始確定}                                     \}}
{\{ --------------------------------------------------------------------- \}}
   sbv=sbcount==8;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02M}{受信中}                                           \}}
{\{ --------------------------------------------------------------------- \}}
   if (RESET|rcomoff)
      rcomon=0;                      {\{ c \}}
   else
      if (sbv)
         rcomon=1;                   {\{ a \}}
      else
         rcomon=rcomon;              {\{ b \}}
      endif
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02N}{ビット計数器}                                     \}}
{\{ --------------------------------------------------------------------- \}}
   if (rcomon)
      if (scbp)
         bitcount=bitcount+1;        {\{ a \}}
      else
         bitcount=bitcount;          {\{ b \}}
      endif
   else
      bitcount=0;                    {\{ c \}}
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02P}{通信終了}                                         \}}
{\{ --------------------------------------------------------------------- \}}
   rcomoff=bitcount==9;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02Q}{ビット取得のシフトレジスタ}                       \}}
{\{ --------------------------------------------------------------------- \}}
   if (rcomon)
      if (scbp)                       {\{ a \}}
         rshift.0=RXD;
         rshift.1:8=rshift.0:7;
      else                            {\{ b \}}
         rshift=rshift;
      endif
   else
      rshift=0;                       {\{ c \}}
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02R}{データ取得}                                       \}}
{\{ --------------------------------------------------------------------- \}}
   if (RESET)
      rdata=0;                       {\{ c \}}
   else
      if (rcomoff)
         rdata=rshift.8:1;           {\{ a \}}
      else
         rdata=rdata;                {\{ b \}}
      endif
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02S}{パリティ取得}                                     \}}
{\{ --------------------------------------------------------------------- \}}
   if (RESET)
      rparity=0;                     {\{ c \}}
   else
      if (rcomoff)
         rparity=rshift.0;           {\{ a \}}
      else
         rparity=rparity;            {\{ b \}}
      endif
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02T}{パリティ用計数器}                                 \}}
{\{ --------------------------------------------------------------------- \}}
   if (RESET)
      paritycount=0;                        {\{ c \}}
   else
      if (bitcount<=7)
         if (scbp)
            if (RXD)
               paritycount=paritycount+1;   {\{ a \}}
            else
               paritycount=paritycount;     {\{ b \}}
            endif
         else
            paritycount=paritycount;        {\{ b \}}
         endif
      else
         paritycount=paritycount;           {\{ b \}}
      endif
   endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F02U}{偶数パリティ計算値}                               \}}
{\{ --------------------------------------------------------------------- \}}
   if (rcomoff)
      eparity=paritycount.0;             {\{ a \}}
   else
      eparity=rparity;                   {\{ b \}}
   endif

ende

{\clearpage}
{\{ ===================================================================== \}}
{\{    \logicso{07F02V}{機能実行譜}                                       \}}
{\{ ===================================================================== \}}
entity sim

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10A}{実効譜端子}                                       \}}
{\{ --------------------------------------------------------------------- \}}
output  RESET;
output  RXD;
output  SC;
output  DATA[8];
output  PARITY;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10A}{手続き譜端子}                                     \}}
{\{ --------------------------------------------------------------------- \}}
output  SEND[2];
output  CTS;
output  SDATA[8];
output  SREQP;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F12A}{検証用出力}                                       \}}
{\{ --------------------------------------------------------------------- \}}
output  TP[12];

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F12B}{検証初期化}                                       \}}
{\{ --------------------------------------------------------------------- \}}
input simres;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10B}{内部信号}                                         \}}
{\{ --------------------------------------------------------------------- \}}
bitr    tc[12];
bitn    node_RESET;
bitn    node_SC;
bitn    node_SREQP;
bitn    node_SDATA[8];
bitn    node_CTS;
bitn    node_SEND[2];

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10C}{出力代入}                                         \}}
{\{ --------------------------------------------------------------------- \}}
   RESET=node_RESET;
   SC   =node_SC;
   SREQP=node_SREQP;
   SDATA=node_SDATA;
   CTS  =node_CTS;
   SEND =node_SEND;
   TP=tc;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10D}{実効譜導入}                                       \}}
{\{ --------------------------------------------------------------------- \}}
   part main(RESET,RXD,SC,DATA,PARITY)

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10E}{手続き譜導入}                                     \}}
{\{ --------------------------------------------------------------------- \}}
   node_SEND=LDL07E16A(node_RESET,node_CTS,node_SDATA,node_SC,node_SREQP);

   node_SEND.2=1;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10F}{検査位置}                                         \}}
{\{ --------------------------------------------------------------------- \}}
   simres=0;
   if (!simres) tc=tc+1; endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10G}{チップ初期化}                                     \}}
{\{ --------------------------------------------------------------------- \}}
   if (tc<5) node_RESET=1; endif

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10H}{通信CLK}                                          \}}
{\{ --------------------------------------------------------------------- \}}
   node_SC=tc.1;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10J}{送信許可}                                         \}}
{\{ --------------------------------------------------------------------- \}}
   node_CTS=1;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10K}{送信データ}                                       \}}
{\{ --------------------------------------------------------------------- \}}
   node_SDATA=0x5a;

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10L}{送信起点}                                         \}}
{\{ --------------------------------------------------------------------- \}}
   switch(tc)
      case 10: node_SREQP=1;
   endswitch

{\{ --------------------------------------------------------------------- \}}
{\{    \logicso{07F10M}{受信端子}                                         \}}
{\{ --------------------------------------------------------------------- \}}
   RXD=node_SEND.0;

ende

endlogic
